<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/addProducts.css" />
    <title>Add Product</title>
  </head>

  <body>
    <div class="form-main-wrapper">
      <h2>Create New Product</h2>

      <form action="/products/add" method="POST">
        <div class="form-grid">
          <!-- Bag Name -->
          <div class="form-group full-width">
            <label>Bag Name:</label>
            <input type="text" name="name" required />
          </div>

          <!-- Price -->
          <div class="form-group">
            <label>Price ($):</label>
            <input type="number" name="price" required />
          </div>

          <!-- Discount -->
          <div class="form-group">
            <label>Discount ($):</label>
            <input type="number" name="discount" value="0" />
          </div>

          <!-- Background Color -->
          <div class="form-group">
            <label>Background Color:</label>
            <input type="text" name="bgcolor" placeholder="#f3f3f3" />
          </div>

          <!-- Panel Color -->
          <div class="form-group">
            <label>Panel Color:</label>
            <input type="text" name="panelcolor" placeholder="#ffffff" />
          </div>

          <!-- Text Color -->
          <div class="form-group full-width">
            <label>Text Color:</label>
            <input type="text" name="textcolor" placeholder="#000000" />
          </div>

          <!-- Image URL -->
          <div class="form-group full-width">
            <label>Image URL:</label>
            <input
              type="text"
              name="image"
              placeholder="https://example.com/bag.jpg"
              required
            />
          </div>

          <!-- Description -->
          <div class="form-group full-width">
            <label>Description:</label>
            <textarea name="description"></textarea>
          </div>
        </div>

        <button type="submit">Add Product</button>
      </form>
    </div>
  </body>
</html>
