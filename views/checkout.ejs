<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/checkout.css" />
    <title>Checkout</title>
  </head>
  <body>
    <div class="checkout-main-page">
           <!-- navbar wrapper -->
         <% if(user.isAdmin === true){ %>
        <div class="navbar-wrapper">
        <div class="logo">NAQSH</div>
        <div class="nav-links-wrapper">
          <a href="/">Home</a>
          <a href="/products">Products</a>
          <a href="/cart">Cart (0)</a>
          <a href="/cart">Add Products</a>
          <a href="/profile"><img src="/uploads/<%= user.picture %>" alt="profile-img"></a>
        </div>
      </div>
   <% } else{ %>
    <div class="navbar-wrapper">
        <div class="logo">NAQSH</div>
        <div class="nav-links-wrapper">
          <a href="/">Home</a>
          <a href="/products">Products</a>
          <a href="/cart">Cart (0)</a>
          <a href="/profile"><img src="/uploads/<%= user.picture %>" alt="profile-img"></a>
        </div>
      </div>
   <% } %>
   <!-- main checkout wrapper -->

     <!-- checkout title wrapper -->
      <div class="checkout-title-wrapper">
        <h1>Checkout</h1>
      </div>

      <div class="checkout-wrapper">
        <div class="checkout-left-wrapper">
          <form action="/checkout/place-order" method="post">
            <h3>Customer Information</h3>
            <label for="name">Name : </label>
            <input type="text" placeholder="Name" name="name" required>
            <label for="email">Email : </label>
            <input type="email" placeholder="Email" name="email" required>
            <label for="num">Phone : </label>
            <input type="tel" placeholder="03XX-XXXXXXX" name="num" required>
            <h3>Shipping Address</h3>
            <label for="address">Address : </label>
            <input type="text" placeholder="Address" name="address" required>
            <label for="city">City : </label>
            <input type="text" placeholder="city" name="city" required>
            <button type="submit">Place Order</button>
          </form>
        </div>
        <div class="checkout-right-wrapper">
          <h2>Order Summary</h2>
          <div class="order-items-wrapper">
            <% cart.items.forEach((item)=>{ %>
          <div class="order-item">
            <div class="order-item-info">
              <h4><%= item.product.name %></h4>
              <span> Rs. <%= item.product.price * item.quantity %> </span>
            </div>
            <p>x  <%= item.quantity %></p> 
          </div>

         <%   }) %>
          </div>
        </div>
      </div>

      <!-- footer -->
      <%- include("partials/footer") %>
    </div>
  </body>
</html>
