<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/CartPage.css" />
    <link
  href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css"
  rel="stylesheet"
/>
    <title>Cart</title>
  </head>
  <body>
    <div class="main-cart-page-wrapper">
      <div class="navbar-wrapper">
        <div class="logo">NAQSH</div>
        <div class="nav-links-wrapper">
          <a href="/">Home</a>
          <a href="/products">Products</a>
          <a href="/cart">Cart (<%= cart.items.length %>)</a>
          <a href="/profile"><img src="/uploads/<%= user.picture %>" alt="profile-img"></a>
        </div>
      </div>
       <div class="cart-title-wrapper">
      <h2>Your Cart.</h2>
    </div>
     <% if (!cart || cart.items.length === 0) { %>
    <div class="empty-cart">
       <h2>No Product has been Added to Cart.</h2>
    </div>

<% } else { %>
     <div class="main-cart">
       <div class="cart-items-wrapper">
    <% cart.items.forEach(function(cartItem) { %>
      <div class="cart-item">
        <div class="cart-item-img-wrapper">
          <img src="<%= cartItem.product.image %>">
        </div>
         <div class="cart-item-details-wrapper">
           <h2><%= cartItem.product.name %></h2>
           <p>Price: Rs. <%= cartItem.product.price %></p>
           <p>Quantity: <%= cartItem.quantity %></p>
           <div class="cart-delete-btn">
           <form action="/cart/delete/<%= cartItem.product.id %>" method="POST">
           <button type="submit">Delete Item</button>
           </form>
          </div>   
         </div>
      </div>
    <% }) %>
       </div>
       <div class="order-summery-wrapper">
          <h3>Order Summary</h3>

     <p>
    Total Items:
    <%= cart.items.length %>
    </p>

    <p>
    Subtotal:
    Rs. <%= subTotal %>
    </p>

    <p>
    Discount:
    - Rs. <%= totalDiscount %>
        </p>

        <hr>
  
  <h3>
    Total:
    Rs. <%= total %>
  </h3>

        <a href="/products">
    Continue Shopping
        </a>

        <a href="/checkout">
    Checkout
        </a>
       </div>
     </div>
 
<% } %>
<!-- footer -->
  <%- include('./partials/footer.ejs') %>
    </div>
  </body>
</html>
