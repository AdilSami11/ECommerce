<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/CartPage.css" />
    <title>Cart</title>
  </head>
  <body>
    <div class="main-cart-page-wrapper">
      <div class="navbar-wrapper">
        <div class="logo">NAQSH</div>
        <div class="nav-links-wrapper">
          <a href="/">Home</a>
          <a href="/products">Products</a>
          <a href="/cart">Cart (<%= cart.items.length %>)</a>
          <a href="/profile"><img src="/images/profile-img.webp" alt="profile-img"></a>
        </div>
      </div>
       <div class="cart-title-wrapper">
      <h2>Your Cart.</h2>
    </div>
     <% if (!cart || cart.items.length === 0) { %>

  <h1>No Product has been Added to Cart.</h1>

<% } else { %>

  <div class="cart-items-wrapper">
    <% cart.items.forEach(function(cartItem) { %>
      <div class="cart-item">
        <div class="cart-item-img-wrapper">
          <img src="<%= cartItem.product.image %>">
        </div>
         <div class="cart-item-details-wrapper">
           <h2><%= cartItem.product.name %></h2>
           <p>Price: Rs. <%= cartItem.product.price %></p>
           <p>Quantity: <%= cartItem.quantity %></p>
           <div class="cart-delete-btn">
           <form action="/cart/delete/<%= cartItem.product.id %>" method="POST">
           <button type="submit">Delete Item</button>
           </form>
          </div>   
         </div>
      </div>
    <% }) %>
  </div>
<% } %>
    </div>
  </body>
</html>
