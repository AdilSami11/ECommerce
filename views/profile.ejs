<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/profilePage.css" />
    <link
      href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css"
      rel="stylesheet"
    />
    <title>Profile</title>
  </head>
  <body>
    <div class="main-profile-wrapper">
      <%- include('./partials/Navbar.ejs') %>
      <div class="profile-title-wrapper">
        <h1>Your Profile</h1>
      </div>
      <div class="profile-details-wrapper">
        <div class="profile-card">
          <div class="profile-img-wrapper">
            <img src="/uploads/<%= user.picture %>" alt="profile-img" />
          </div>
          <div class="profile-info-wrapper">
            <h3>Name : <%= user.name %></h3>
            <h4>Email : <%= user.email %></h4>
            <div class="profile-btns">
              <a href="/profile/edit">
                <button class="logout-btn">Edit</button>
              </a>
              <a href="/auth/logout">
                <button class="logout-btn">Log Out</button>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
    <script src="/javascripts/navbarLogic.js" defer></script>
  </body>
</html>
