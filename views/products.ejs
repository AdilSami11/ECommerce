<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/productsPage.css" />
    <link
  href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css"
  rel="stylesheet"
/>
    <title>Shop - Products</title>
  </head>
  <body>
    <div class="products-page-wrapper">
        <% if(user.isAdmin === true){ %>
        <div class="navbar-wrapper">
        <div class="logo">NAQSH</div>
        <div class="nav-links-wrapper">
          <a href="/">Home</a>
          <a href="/products">Products</a>
          <a href="/cart">Cart (<%= cartCount %>)</a>
          <a href="/products/add">Add Products</a>
          <a href="/profile"><img src="/uploads/<%= user.picture %>" alt="profile-img"></a>
        </div>
      </div>
   <% } else{ %>
    <div class="navbar-wrapper">
        <div class="logo">NAQSH</div>
        <div class="nav-links-wrapper">
          <a href="/">Home</a>
          <a href="/products">Products</a>
          <a href="/cart">Cart (<%= cartCount %>)</a>
          <a href="/profile"><img src="/uploads/<%= user.picture %>" alt="profile-img"></a>
        </div>
      </div>
   <% } %>
      <div class="main-poducts-wrapper">
        <div class="products-title-wrapper">
          <h1>ALL BAGS</h1>
          <p>
            Find the perfect bag for <br />
            every journey.
          </p>
        </div>
        <!-- filteration -->
        <div class="products-filteraion-wrapper">
          <form action="/products" method="GET" >

     <label for="sort">Sort By</label>

     <select id="sort" name="sort">
        <option value="">Default</option>
        <option value="price-low" <%= sort === 'price-low' ? 'selected' : '' %>>
        Price: Low to High
        </option>
       <option value="price-high" <%= sort === 'price-high' ? 'selected' : '' %>>
        Price: High to Low
       </option>

       <option value="discount" <%= sort === 'discount' ? 'selected' : '' %>>
        Highest Discount
       </option>
       </select>
     <button type="submit">Apply</button>
   </form>
        </div>
        <!-- products cards wrapper -->
        <div class="products-cards-wrapper">
          <% getAllProducts.forEach(function(prod){ %>
                <div class="product-card">
                   <div class="prod-img">
                    <img src="<%=prod.image %>" alt="<%=prod.name%>">
                   </div>
                   <div class="prod-info"> 
                    <h2><%= prod.name %></h2>
                    <p><%= prod.description %></p>
                    <p id="prod-price"> Rs. <%= prod.price %></p>
                    <a href="/products/<%=prod._id %>">
                      <button>View Product</button>
                    </a>
                  </div>
                </div>
         <% }) %>
        </div>
      </div>
      <!-- footer -->
       <%- include('./partials/footer.ejs') %>
    </div>
  </body>
</html>
