<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/orderPage.css">
    <title>Orders</title>
  </head>
  <body>
<div class="order-main-wrapper">
 <!-- navbar wrapper -->
    <% if(user.isAdmin === true){ %>
        <div class="navbar-wrapper">
        <div class="logo">NAQSH</div>
        <div class="nav-links-wrapper">
          <a href="/">Home</a>
          <a href="/products">Products</a>
          <a href="/cart">Add Products</a>
          <a href="/profile"><img src="/uploads/<%= user.picture %>" alt="profile-img"></a>
        </div>
      </div>
   <% } else{ %>
    <div class="navbar-wrapper">
        <div class="logo">NAQSH</div>
        <div class="nav-links-wrapper">
          <a href="/">Home</a>
          <a href="/products">Products</a>
          <a href="/cart">Cart (0)</a>
          <a href="/profile"><img src="/uploads/<%= user.picture %>" alt="profile-img"></a>
        </div>
      </div>
   <% } %>

   <!-- orderPage-title-wrapper -->
    <div class="order-title-wrapper">
        <h3>My Orders</h3>
        <h2>Track and view everything you've ordered</h2>
    </div>


    <!-- order-card-wrapper -->
     <div class="order-cards-wrapper"></div>
</div>
  </body>
</html>
