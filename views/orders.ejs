<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="stylesheet" href="/stylesheets/orderPage.css">

  <title>Orders</title>
</head>

<body>

  <div class="order-main-wrapper">

<!-- Navbar -->

<% if (user.isAdmin === true) { %>

  <div class="navbar-wrapper">

    <div class="logo">NAQSH</div>

    <div class="nav-links-wrapper">
      <a href="/">Home</a>
      <a href="/products">Products</a>
      <a href="/cart">Add Products</a>

      <a href="/profile">
        <img
          src="/uploads/<%= user.picture %>"
          alt="profile-img"
        >
      </a>
    </div>

  </div>

<% } else { %>

  <div class="navbar-wrapper">

    <div class="logo">NAQSH</div>

    <div class="nav-links-wrapper">
      <a href="/">Home</a>
      <a href="/products">Products</a>
      <a href="/cart">Cart (0)</a>

      <a href="/profile">
        <img
          src="/uploads/<%= user.picture %>"
          alt="profile-img"
        >
      </a>
    </div>

  </div>

<% } %>


<!-- Page Title -->

<div class="order-title-wrapper">

  <h3>My Orders</h3>

  <h2>
    Track and view everything you've ordered
  </h2>

</div>


<!-- Empty Orders -->

<% if (!orders || orders.length === 0) { %>

  <div class="empty-orders">

    <h2>No orders yet</h2>

    <p>
      When you place an order, it will appear here.
    </p>

    <a href="/products">
      Start Shopping
    </a>

  </div>


<% } else { %>


  <!-- Orders -->

  <div class="order-cards-wrapper">

    <% orders.forEach(order => { %>

      <div class="order-card">


        <!-- Order Header -->

        <div class="order-top">

          <div>

            <h3>
              Order #<%= order._id %>
            </h3>

            <p>
              <%= order.createdAt.toDateString() %>
            </p>

          </div>


          <span class="order-status <%= order.status.toLowerCase() %>">
            <%= order.status %>
          </span>

        </div>


        <!-- Order Items -->

        <div class="order-items">

          <% order.items.forEach(item => { %>

            <div class="order-item">

              <img
                src="<%= item.product.image %>"
                alt="<%= item.product.name %>"
              >

              <div class="item-info">

                <h4>
                  <%= item.product.name %>
                </h4>

                <p>
                  Quantity: <%= item.quantity %>
                </p>

              </div>


              <strong>
                PKR <%= item.price * item.quantity %>
              </strong>

            </div>

          <% }) %>

        </div>


        <!-- Order Bottom -->

        <div class="order-bottom">
          <strong>
            Total: PKR <%= order.total %>
          </strong>
          <a href="/products">
            Continue Shopping
          </a>
        </div>

      </div>

    <% }) %>

  </div>

<% } %>
  </div>

</body>

</html>
