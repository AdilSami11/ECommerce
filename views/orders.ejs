<!DOCTYPE html>

<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <link rel="stylesheet" href="/stylesheets/orderPage.css">
  <link
  href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css"
  rel="stylesheet"
/>
  <title>Orders</title>
</head>

<body>

  <div class="order-main-wrapper">
   <!-- Navbar -->
  <%- include('./partials/Navbar.ejs') %>   
<!-- Page Title -->
<div class="order-title-wrapper">
  <h3>My Orders</h3>
  <h2>
    Track and view everything you've ordered
  </h2>
</div>


<!-- Empty Orders -->

<% if (!orders || orders.length === 0) { %>

  <div class="empty-orders">

    <h2>No orders yet</h2>

    <p>
      When you place an order, it will appear here.
    </p>

    <a href="/products">
      Start Shopping
    </a>

  </div>


<% } else { %>


  <!-- Orders -->

  <div class="order-cards-wrapper">

    <% orders.forEach(order => { %>

      <div class="order-card">


        <!-- Order Header -->

        <div class="order-top">

          <div>

            <h3>
              Order #<%= order._id %>
            </h3>

            <p>
              <%= order.createdAt.toDateString() %>
            </p>

          </div>


          <span class="order-status <%= order.status.toLowerCase() %>">
            <%= order.status %>
          </span>

        </div>


        <!-- Order Items -->

        <div class="order-items">

          <% order.items.forEach(item => { %>

            <div class="order-item">

              <img
                src="<%= item.product.image %>"
                alt="<%= item.product.name %>"
              >

              <div class="item-info">

                <h4>
                  <%= item.product.name %>
                </h4>

                <p>
                  Quantity: <%= item.quantity %>
                </p>

              </div>


              <strong>
                PKR <%= item.price * item.quantity %>
              </strong>

            </div>

          <% }) %>

        </div>


        <!-- Order Bottom -->

        <div class="order-bottom">
          <strong>
            Total: PKR <%= order.total %>
          </strong>
          <a href="/products">
            Continue Shopping
          </a>
        </div>

      </div>

    <% }) %>

  </div>

<% } %>
  </div>
    <script src="/javascripts/navbarLogic.js" defer></script>
</body>

</html>
