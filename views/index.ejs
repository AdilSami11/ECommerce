<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="stylesheet" href="/stylesheets/mainPage.css" />
    <link
  href="https://cdn.jsdelivr.net/npm/remixicon@4.9.0/fonts/remixicon.css"
  rel="stylesheet"
/>
    <title>NAQSH-STORE</title>
  </head>

  <body>
    <div class="main-page-wrapper">
      <div class="navbar-wrapper">
        <div class="logo">NAQSH</div>
        <div class="nav-links-wrapper">
          <a href="/">Home</a>
          <a href="/products/add">Products</a>
          <a href="/cart">Cart (0)</a>
          <a href="/auth/logout" class="logout-btn">Logout</a>
        </div>
      </div>
      <!-- hero-section -->
      <div class="hero-sec-wrapper">
        <div class="hero-content">
          <p class="hero-small-text">STYLE • QUALITY • EVERYDAY</p>
          <h1>
            Carry Your<br />
            <span>Style.</span>
          </h1>
          <p class="hero-description">
            Discover stylish and practical bags made for every journey.
          </p>
          <a href="/products" class="hero-btn">Shop Now</a>
        </div>
        <div class="hero-img">
          <img src="/images/Hero_img.png" alt="Hero_img" />
        </div>
      </div>

      <!-- 3-cards-section -->
     <div class="card-main-section">
  <div class="title-wrapper">
    <h2>FEATURED BAGS</h2>
  </div>

  <div class="cards-wrapper">
    <% product.forEach(function(items) { %>

      <div class="card">
        <div class="card-img">
          <img src="<%= items.image %>" alt="<%= items.name %>" />
        </div>

        <div class="card-info">
          <h3 id="product-name">Name: <%=items.name %></h3>
          <p id="product-price">Price :$<%= items.price %></p>
          <!-- <p id="product-desc" ><%= items.description %></p> -->
        </div>
      </div>

    <% }) %>
  </div>
  <div class="view-more-btn">
    <button>View More</button>
  </div>
     </div>
     <!-- why choose us Section -->
      <div class="chooseUs-main-section">
        <div class="choose-us-title">
          <h1>WHY CHOOSE NAQSH?</h1>
          <p>Quality bags designed for everyday life.</p>
        </div>
        <div class="choose-us-cards-wrapper">
          <div class="chooseUs-card">
            <i id="icon" class="ri-heart-line"></i>
            <h2>Premium Quality</h2>
            <p>Carefully selected materials and thoughtful construction.</p>
          </div>
           <div class="chooseUs-card">
            <i id="icon" class="ri-shining-line"></i>           
            <h2>Modern Design</h2>
            <p>Clean, timeless styles made to complement your everyday look.</p>
          </div>
           <div class="chooseUs-card">
           <i id="icon" class="ri-check-double-line"></i>           
            <h2>Made for Everyday</h2>
            <p>Practical bags designed to carry what matters, wherever you go.</p>
          </div>
        </div>
      </div>
    </div>
  </body>
</html>
